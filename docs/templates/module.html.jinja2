{% extends "default/module.html.jinja2" %}

{# Include public inherited methods even when their base module is internal. #}
{% macro inherited(cls) %}
    {% for base, members in cls.inherited_members.items() %}
        {% for m in members if m.kind == "function" and is_public(m) | trim %}
            <div id="{{ m.qualname }}" class="classattr">
                {{ member(m) }}
            </div>
        {% endfor %}
    {% endfor %}
{% endmacro %}
